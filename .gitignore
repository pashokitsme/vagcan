target/
Cargo.lock
**/*.rs.bk
.DS_Store
*.capture.local
.superpowers/
# Agent worktrees + local harness state
.claude/*
# …except the project's own skills. Those are documentation of how this repo is
# worked on, they go stale when the code moves, and a cleanup pass re-verifies
# them against the binary — none of which works if they live only on one machine.
# The parent is `.claude/*` and not `.claude/`: git does not descend into an
# excluded directory, so a negation under one never matches.
!.claude/skills/

# --- research working dir: exclude junk + third-party/proprietary content ---
# Regenerable tooling state
research/**/.venv/
research/**/__pycache__/
research/**/*.pyc
# Proprietary vendor binaries (Ross-Tech VCDS/loader/DLL) — not ours to redistribute
research/clb-crack/bin/
# Third-party reference source + proprietary label/rod DB inputs
research/clb-crack/ref/
research/clb-crack/samples/
# Decoded proprietary label content (RE outputs, not for redistribution)
research/clb-crack/decoded_*.txt
# USB captures: large + contain private vehicle data
research/captures/*.pcapng
research/dumps/
research/logs/
# Ross-Tech VCDS installations: proprietary software and label data, ~300 MB.
# Present for offline research only; never committed.
research/VCDS-*/

# VCDS install symlinks — proprietary Ross-Tech label/ODX data, never commit
research/vcds-data/

# Capture artifacts written by `vagcan sniff` / `scan-dids`: bus traffic from a
# real car, so they carry the VIN. Never committed.
/*.jsonl
research/dumps/
research/logs/
# Ross-Tech VCDS installations: proprietary software and label data, ~300 MB.
# Present for offline research only; never committed.
research/VCDS-*/

# Browser session artifacts from Playwright — logs and DOM snapshots, never source.
.playwright-mcp/

# Generated by `measure view` next to its input; the sample JSON is the source.
crates/vagcan/src/measure/view_sample.html
