+def enforce_min_separation(bus, sep_s: float):
+    """Make `bus.send` wait so consecutive frames are at least `sep_s` apart.
+
+    The SocketCAN path forces its transmit separation with the kernel's
+    `tx_stmin`, which overrides whatever STmin the ECU asks for in flow control.
+    can-isotp 1.9's pure-Python stack has no equivalent option (no
+    `override_receiver_stmin`), so this reproduces that floor at the frame level.
+
+    The override is installed on the instance, so the object stays a genuine
+    python-can `BusABC` — `isotp.CanStack` type-checks for one.
+    """
+    original_send = bus.send
+    state = {"next_ok": 0.0}
+
+    def send(msg, timeout=None):
+        now = time.monotonic()
+        if now < state["next_ok"]:
+            time.sleep(state["next_ok"] - now)
+        try:
+            return original_send(msg, timeout) if timeout is not None else original_send(msg)
+        finally:
+            state["next_ok"] = time.monotonic() + sep_s
+
+    bus.send = send
+    return bus
+
